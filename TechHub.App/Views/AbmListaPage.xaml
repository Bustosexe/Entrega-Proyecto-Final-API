<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             x:Class="TechHub.App.Views.AbmListaPage"
             x:DataType="vm:AbmListaViewModel"
             Title="{Binding Titulo}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="12,10,12,4" Spacing="8">
            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Borde}" BackgroundColor="White" Padding="0">
                <SearchBar Text="{Binding Buscar}" Placeholder="Buscar..." />
            </Border>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding ResultadoTexto}" Style="{StaticResource Secundario}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{Binding TextoNuevo}" Command="{Binding NuevoCommand}" HeightRequest="40" FontSize="13" />
            </Grid>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding EstaRefrescando}" Command="{Binding RecargarCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="Single" SelectionChanged="OnItemSeleccionado"
                            RemainingItemsThreshold="4" RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}"
                            Margin="12,4,12,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30,60" Spacing="10">
                        <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />
                        <Label Text="{Binding MensajeVacio}" Style="{StaticResource Secundario}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AbmItem">
                        <Border Style="{StaticResource Tarjeta}" Padding="12" Opacity="{Binding Opacidad}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                                <Border Grid.Column="1" Style="{StaticResource Etiqueta}" BackgroundColor="{Binding EtiquetaColor}"
                                        IsVisible="{Binding TieneEtiqueta}">
                                    <Label Text="{Binding Etiqueta}" Style="{StaticResource TextoEtiqueta}" />
                                </Border>
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subtitulo}" Style="{StaticResource Secundario}" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detalle}" Style="{StaticResource Secundario}"
                                       FontSize="12" IsVisible="{Binding TieneDetalle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
