<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             xmlns:m="clr-namespace:TechHub.App.Models"
             x:Class="TechHub.App.Views.IngresosPage"
             x:DataType="vm:IngresosViewModel"
             Title="Compras a proveedores">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nueva" IconImageSource="ic_agregar.png" Command="{Binding NuevoCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="12,10,12,4" Spacing="8">
            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Borde}" BackgroundColor="White" Padding="0">
                <SearchBar Text="{Binding Buscar}" Placeholder="Producto, proveedor o comprobante..." />
            </Border>
            <Button Text="+ Registrar compra" Command="{Binding NuevoCommand}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding EstaRefrescando}" Command="{Binding RecargarCommand}">
            <CollectionView ItemsSource="{Binding Ingresos}"
                            RemainingItemsThreshold="4" RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}"
                            Margin="12,4,12,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30,60" Spacing="10">
                        <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />
                        <Label Text="{Binding MensajeVacio}" Style="{StaticResource Secundario}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:IngresoDto">
                        <Border Style="{StaticResource Tarjeta}" Padding="12">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                <Label Text="{Binding Producto}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding TotalTexto}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detalle}" Style="{StaticResource Secundario}" />
                                <Label Grid.Row="2" Text="{Binding Comprobante}" Style="{StaticResource Secundario}" FontSize="12" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding FechaTexto}" Style="{StaticResource Secundario}" FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
