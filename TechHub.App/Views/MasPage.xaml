<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TechHub.App.Views.MasPage"
             Title="Más opciones">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Border Style="{StaticResource Tarjeta}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="logo.png" WidthRequest="48" HeightRequest="48" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label x:Name="LblNombre" Style="{StaticResource Subtitulo}" />
                        <Label x:Name="LblEmail" Style="{StaticResource Secundario}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Gestión" Style="{StaticResource Rotulo}" />
            <Button Text="Categorías" Style="{StaticResource BotonSecundario}" Clicked="OnCategorias" />
            <Button Text="Proveedores" Style="{StaticResource BotonSecundario}" Clicked="OnProveedores" />
            <Button Text="Clientes" Style="{StaticResource BotonSecundario}" Clicked="OnClientes" />
            <Button Text="Usuarios y administradores" Style="{StaticResource BotonSecundario}" Clicked="OnUsuarios" />

            <Label Text="Sesión" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
            <Button Text="Cerrar sesión" Style="{StaticResource BotonPeligro}" Clicked="OnCerrarSesion" />

            <Label x:Name="LblServidor" Style="{StaticResource Secundario}" FontSize="11" HorizontalTextAlignment="Center" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
