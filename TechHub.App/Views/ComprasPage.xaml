<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             xmlns:m="clr-namespace:TechHub.App.Models"
             x:Class="TechHub.App.Views.ComprasPage"
             x:DataType="vm:ComprasViewModel"
             Title="Compras a proveedores">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nueva" IconImageSource="ic_agregar.png" Command="{Binding NuevoCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="16,10,16,4" Spacing="10">
            <Border Style="{StaticResource CampoBorde}" Padding="4,0">
                <SearchBar Text="{Binding Buscar}" Placeholder="Factura, proveedor o producto..." />
            </Border>
            <Button Text="+ Registrar compra" Command="{Binding NuevoCommand}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding EstaRefrescando}" Command="{Binding RecargarCommand}">
            <CollectionView ItemsSource="{Binding Compras}"
                            RemainingItemsThreshold="3" RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}"
                            Margin="16,6,16,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30,60" Spacing="10">
                        <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />
                        <Label Text="{Binding MensajeVacio}" Style="{StaticResource Secundario}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:CompraDto">
                        <!-- Una tarjeta por factura, con sus renglones -->
                        <Border Style="{StaticResource Tarjeta}" Padding="16">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Proveedor}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Factura}" Style="{StaticResource Secundario}" FontSize="13" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding TotalTexto}" Style="{StaticResource Precio}" FontSize="16" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding Resumen}" Style="{StaticResource Secundario}" FontSize="12" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource Borde}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="m:DetalleCompraDto">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding Linea}" FontSize="13" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="1" Text="{Binding SubtotalTexto}" FontSize="13"
                                                       TextColor="{StaticResource TextoSecundario}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="{Binding Registro}" Style="{StaticResource Secundario}" FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
