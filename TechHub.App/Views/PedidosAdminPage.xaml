<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             xmlns:m="clr-namespace:TechHub.App.Models"
             x:Class="TechHub.App.Views.PedidosAdminPage"
             x:DataType="vm:PedidosAdminViewModel"
             Title="Pedidos">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="12,10,12,0" Spacing="6">
            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Borde}" BackgroundColor="White" Padding="0">
                <SearchBar Text="{Binding Buscar}" Placeholder="Código, cliente o DNI..." />
            </Border>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding ResultadoTexto}" Style="{StaticResource Secundario}" VerticalOptions="Center" />
                <Picker Grid.Column="1" Title="Estado" ItemsSource="{Binding Estados}" SelectedItem="{Binding Estado}" WidthRequest="150" />
            </Grid>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding EstaRefrescando}" Command="{Binding RecargarCommand}">
            <CollectionView ItemsSource="{Binding Pedidos}" SelectionMode="Single" SelectionChanged="OnPedidoSeleccionado"
                            RemainingItemsThreshold="3" RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}"
                            Margin="12,6,12,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30,60" Spacing="10">
                        <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />
                        <Label Text="{Binding MensajeVacio}" Style="{StaticResource Secundario}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:PedidoDto">
                        <Border Style="{StaticResource Tarjeta}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                <Label Text="{Binding Cliente}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                                <Border Grid.Column="1" Style="{StaticResource Etiqueta}" BackgroundColor="{Binding EstadoColor}">
                                    <Label Text="{Binding Estado}" Style="{StaticResource TextoEtiqueta}" />
                                </Border>
                                <Label Grid.Row="1" Text="{Binding Codigo}" Style="{StaticResource Secundario}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding FechaTexto}" Style="{StaticResource Secundario}" FontSize="12" />
                                <Label Grid.Row="2" Text="{Binding Resumen}" Style="{StaticResource Secundario}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding TotalTexto}" Style="{StaticResource Precio}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
