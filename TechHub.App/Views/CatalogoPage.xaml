<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             xmlns:m="clr-namespace:TechHub.App.Models"
             x:Class="TechHub.App.Views.CatalogoPage"
             x:DataType="vm:CatalogoViewModel"
             Title="TechHub">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Encabezado con buscador -->
        <VerticalStackLayout Grid.Row="0" Padding="20,4,20,4" Spacing="14">
            <VerticalStackLayout Spacing="2">
                <Label Text="Encontrá tu próximo componente" FontSize="26" FontAttributes="Bold" LineHeight="1.1" />
                <Label Text="Stock actualizado en tiempo real" Style="{StaticResource Secundario}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource CampoBorde}" Padding="4,0">
                <SearchBar Text="{Binding Buscar}" Placeholder="Buscar RTX, Ryzen, DDR5..." />
            </Border>
        </VerticalStackLayout>

        <!-- Filtro por categoría -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categorias}" Spacing="8" Padding="20,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoriaFiltro">
                        <Border Padding="16,9" StrokeShape="RoundRectangle 20" StrokeThickness="0"
                                BackgroundColor="{Binding Fondo}" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoriaTocada" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Nombre}" TextColor="{Binding ColorTexto}" FontSize="13" FontAttributes="Bold" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Resultados, filtro de precio y orden -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="20,8,14,0">
            <Label Text="{Binding ResultadoTexto}" Style="{StaticResource Secundario}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="{Binding PrecioTexto}" Command="{Binding ElegirPrecioCommand}"
                    Style="{StaticResource BotonChico}" VerticalOptions="Center" />
            <Picker Grid.Column="2" ItemsSource="{Binding Ordenes}" SelectedItem="{Binding Orden}"
                    WidthRequest="125" FontSize="13" Title="Ordenar" />
        </Grid>

        <!-- Grilla de productos con scroll infinito (paginación de la API) -->
        <RefreshView Grid.Row="3" IsRefreshing="{Binding EstaRefrescando}" Command="{Binding RecargarCommand}">
            <CollectionView ItemsSource="{Binding Productos}"
                            SelectionMode="Single"
                            SelectionChanged="OnProductoSeleccionado"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}"
                            Margin="16,4,16,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="14" HorizontalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <!-- Destacados: los más vendidos (solo sin filtros) -->
                <CollectionView.Header>
                    <VerticalStackLayout IsVisible="{Binding MostrarDestacados}" Spacing="12" Padding="0,8,0,14">
                        <Label Text="Los más vendidos" Style="{StaticResource Subtitulo}" FontSize="20" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Destacados}" Spacing="14">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:ProductoDto">
                                        <VerticalStackLayout Spacing="6" WidthRequest="150">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDestacadoTocado" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <Border Style="{StaticResource CajaImagen}" HeightRequest="120">
                                                <Image Source="{Binding ImagenCompleta}" Aspect="AspectFit" />
                                            </Border>
                                            <Label Text="{Binding Nombre}" FontSize="13" FontAttributes="Bold" MaxLines="2"
                                                   LineBreakMode="TailTruncation" HeightRequest="36" />
                                            <Label Text="{Binding PrecioTexto}" FontSize="14" TextColor="{StaticResource TextoSecundario}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                        <Label Text="Todos los productos" Style="{StaticResource Subtitulo}" FontSize="20" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30,60" Spacing="10">
                        <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />
                        <Label Text="{Binding MensajeVacio}" HorizontalTextAlignment="Center" Style="{StaticResource Secundario}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:ProductoDto">
                        <VerticalStackLayout Spacing="6" Padding="0,0,0,6">
                            <Border Style="{StaticResource CajaImagen}" HeightRequest="150">
                                <Image Source="{Binding ImagenCompleta}" Aspect="AspectFit" />
                            </Border>
                            <Label Text="{Binding MarcaCategoria}" Style="{StaticResource Mini}" LineBreakMode="TailTruncation" Margin="2,2,2,0" />
                            <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="14" MaxLines="2"
                                   LineBreakMode="TailTruncation" HeightRequest="40" Margin="2,0" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="2,0">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding PrecioTexto}" Style="{StaticResource Precio}" FontSize="16" />
                                    <Label Text="{Binding StockTexto}" TextColor="{Binding StockColor}" FontSize="11" />
                                </VerticalStackLayout>
                                <!-- Agregar rápido al carrito -->
                                <Button Grid.Column="1" Text="+" FontSize="22" Padding="0" WidthRequest="40" HeightRequest="40"
                                        CornerRadius="20" VerticalOptions="Center" IsEnabled="{Binding PuedeAgregar}"
                                        Clicked="OnAgregarRapido" />
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
