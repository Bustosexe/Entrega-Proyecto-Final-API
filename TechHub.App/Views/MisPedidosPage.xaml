<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             xmlns:m="clr-namespace:TechHub.App.Models"
             x:Class="TechHub.App.Views.MisPedidosPage"
             x:DataType="vm:MisPedidosViewModel"
             Title="Mis pedidos">

    <Grid>
        <!-- Visitante: invitación a ingresar -->
        <VerticalStackLayout IsVisible="{Binding EsVisitante}" Padding="30,90" Spacing="14">
            <Image Source="ic_pedidos.png" HeightRequest="56" Opacity="0.35" />
            <Label Text="Seguí tus compras" Style="{StaticResource Subtitulo}" HorizontalTextAlignment="Center" />
            <Label Text="Iniciá sesión para ver el estado de tus pedidos." Style="{StaticResource Secundario}"
                   HorizontalTextAlignment="Center" />
            <Button Text="Ingresar" Command="{Binding IrALoginCommand}" />
        </VerticalStackLayout>

        <!-- Comprador: historial paginado -->
        <RefreshView IsVisible="{Binding EstaLogueado}" IsRefreshing="{Binding EstaRefrescando}" Command="{Binding RecargarCommand}">
            <CollectionView ItemsSource="{Binding Pedidos}" SelectionMode="Single" SelectionChanged="OnPedidoSeleccionado"
                            RemainingItemsThreshold="3" RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}"
                            Margin="12,12,12,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30,80" Spacing="10">
                        <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />
                        <Label Text="{Binding MensajeVacio}" Style="{StaticResource Secundario}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:PedidoDto">
                        <Border Style="{StaticResource Tarjeta}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Label Text="{Binding Codigo}" FontAttributes="Bold" FontSize="15" />
                                <Border Grid.Column="1" Style="{StaticResource Etiqueta}" BackgroundColor="{Binding EstadoColor}">
                                    <Label Text="{Binding EstadoTexto}" Style="{StaticResource TextoEtiqueta}" />
                                </Border>
                                <Label Grid.Row="1" Text="{Binding FechaTexto}" Style="{StaticResource Secundario}" />
                                <Label Grid.Row="2" Text="{Binding Resumen}" Style="{StaticResource Secundario}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding TotalTexto}" Style="{StaticResource Precio}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
