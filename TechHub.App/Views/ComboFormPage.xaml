<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             x:Class="TechHub.App.Views.ComboFormPage"
             x:DataType="vm:ComboFormViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="6">

            <Label Text="Nombre *" Style="{StaticResource Rotulo}" />
            <Border Style="{StaticResource CampoBorde}">
                <Entry Text="{Binding Nombre}" Placeholder="Ej: Kit AMD Gamer" MaxLength="100" />
            </Border>

            <Label Text="Descripción" Style="{StaticResource Rotulo}" />
            <Border Style="{StaticResource CampoBorde}">
                <Entry Text="{Binding Descripcion}" MaxLength="500" />
            </Border>

            <Label Text="Descuento del combo (%) *" Style="{StaticResource Rotulo}" />
            <Border Style="{StaticResource CampoBorde}">
                <Entry Text="{Binding PorcentajeTexto}" Keyboard="Numeric" MaxLength="2" Placeholder="1 a 50" />
            </Border>

            <Label Text="Productos del combo *" Style="{StaticResource Rotulo}" />
            <Label Text="Podés combinar cualquier producto: una PC completa o solo algunos componentes."
                   Style="{StaticResource Mini}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lineas}" Spacing="8" Margin="0,4,0,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComboLinea">
                        <Border Style="{StaticResource Tarjeta}" Padding="12">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Detalle}" Style="{StaticResource Mini}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Quitar" Style="{StaticResource BotonChico}" Clicked="OnQuitar" />
                                <HorizontalStackLayout Grid.Row="1" Spacing="10">
                                    <Button Text="−" Style="{StaticResource BotonCircular}" Clicked="OnMenos" />
                                    <Label Text="{Binding Cantidad}" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="28" HorizontalTextAlignment="Center" />
                                    <Button Text="+" Style="{StaticResource BotonCircular}" Clicked="OnMas" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="+ Agregar producto" Command="{Binding AgregarProductoCommand}" Style="{StaticResource BotonSecundario}" />
            <Label Text="{Binding Resumen}" FontAttributes="Bold" TextColor="{StaticResource Primario}" FontSize="13" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <Label Text="Combo activo" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding Activo}" />
            </Grid>

            <Button Text="Guardar" Command="{Binding GuardarCommand}" Margin="0,16,0,0" />
            <Button Text="Dar de baja" Command="{Binding BajaCommand}" Style="{StaticResource BotonPeligro}"
                    IsVisible="{Binding PuedeBorrar}" />
            <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
