<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             xmlns:m="clr-namespace:TechHub.App.Models"
             x:Class="TechHub.App.Views.PedidoDetallePage"
             x:DataType="vm:PedidoDetalleViewModel"
             Title="{Binding Titulo}">

    <RefreshView IsRefreshing="{Binding EstaRefrescando}" Command="{Binding CargarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20,16" Spacing="16">

                <!-- Encabezado: estado y línea de tiempo -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="{Binding Pedido.Codigo}" Style="{StaticResource Titulo}" />
                            <Label Text="{Binding Pedido.FechaTexto}" Style="{StaticResource Secundario}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource Etiqueta}" BackgroundColor="{Binding Pedido.EstadoColor}">
                            <Label Text="{Binding Pedido.EstadoTexto}" Style="{StaticResource TextoEtiqueta}" />
                        </Border>
                    </Grid>

                    <Grid IsVisible="{Binding MostrarLineaDeTiempo}" ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto"
                          RowDefinitions="Auto,Auto,Auto" Margin="0,16,0,0" RowSpacing="4">
                        <BoxView Grid.Column="0" WidthRequest="14" HeightRequest="14" CornerRadius="7" Color="{Binding Paso1Color}" />
                        <BoxView Grid.Column="1" HeightRequest="2" Color="{Binding Linea1Color}" VerticalOptions="Center" />
                        <BoxView Grid.Column="2" WidthRequest="14" HeightRequest="14" CornerRadius="7" Color="{Binding Paso2Color}" />
                        <BoxView Grid.Column="3" HeightRequest="2" Color="{Binding Linea2Color}" VerticalOptions="Center" />
                        <BoxView Grid.Column="4" WidthRequest="14" HeightRequest="14" CornerRadius="7" Color="{Binding Paso3Color}" />
                        <BoxView Grid.Column="5" HeightRequest="2" Color="{Binding Linea3Color}" VerticalOptions="Center" />
                        <BoxView Grid.Column="6" WidthRequest="14" HeightRequest="14" CornerRadius="7" Color="{Binding Paso4Color}" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="7" ColumnDefinitions="*,*,*,*">
                            <Label Text="Pedido" Style="{StaticResource Mini}" />
                            <Label Grid.Column="1" Text="Pago enviado" Style="{StaticResource Mini}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="Confirmado" Style="{StaticResource Mini}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="Entregado" Style="{StaticResource Mini}" HorizontalTextAlignment="End" />
                        </Grid>
                        <!-- Fecha real de cada paso -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="7" ColumnDefinitions="*,*,*,*">
                            <Label Text="{Binding Paso1Fecha}" FontSize="10" TextColor="{StaticResource TextoTenue}" />
                            <Label Grid.Column="1" Text="{Binding Paso2Fecha}" FontSize="10" TextColor="{StaticResource TextoTenue}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="{Binding Paso3Fecha}" FontSize="10" TextColor="{StaticResource TextoTenue}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="{Binding Paso4Fecha}" FontSize="10" TextColor="{StaticResource TextoTenue}" HorizontalTextAlignment="End" />
                        </Grid>
                    </Grid>

                    <Border IsVisible="{Binding EsCancelado}" BackgroundColor="#FEF2F2" StrokeThickness="0"
                            StrokeShape="RoundRectangle 12" Padding="14,10" Margin="0,8,0,0">
                        <Label Text="Este pedido fue cancelado." TextColor="{StaticResource Peligro}" FontAttributes="Bold" />
                    </Border>

                    <Label Text="{Binding EstadoAyuda}" Style="{StaticResource Secundario}" FontSize="14" Margin="0,10,0,0" />
                </VerticalStackLayout>

                <!-- Pago rechazado -->
                <Border IsVisible="{Binding TieneRechazo}" BackgroundColor="#FEF2F2" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" Padding="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="El comprobante fue rechazado" TextColor="{StaticResource Peligro}" FontAttributes="Bold" />
                        <Label Text="{Binding Pedido.MotivoRechazo}" TextColor="{StaticResource Peligro}" />
                        <Label Text="Revisá la transferencia y volvé a subir el comprobante." Style="{StaticResource Secundario}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Datos para transferir (comprador, esperando pago) -->
                <Border IsVisible="{Binding MostrarDatosPago}" Style="{StaticResource Tarjeta}" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Transferí" Style="{StaticResource Secundario}" />
                        <Label Text="{Binding TotalTransferir}" FontSize="30" FontAttributes="Bold" Margin="0,-10,0,0" />

                        <Grid ColumnDefinitions="*,Auto" Style="{StaticResource FilaDato}">
                            <VerticalStackLayout>
                                <Label Text="Alias" Style="{StaticResource Mini}" />
                                <Label Text="{Binding DatosPago.Alias}" FontAttributes="Bold" FontSize="16" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Copiar" Style="{StaticResource BotonChico}"
                                    Command="{Binding CopiarCommand}" CommandParameter="{Binding DatosPago.Alias}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Style="{StaticResource FilaDato}">
                            <VerticalStackLayout>
                                <Label Text="CBU / CVU" Style="{StaticResource Mini}" />
                                <Label Text="{Binding DatosPago.Cbu}" FontSize="14" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Copiar" Style="{StaticResource BotonChico}"
                                    Command="{Binding CopiarCommand}" CommandParameter="{Binding DatosPago.Cbu}" />
                        </Grid>
                        <VerticalStackLayout>
                            <Label Text="Titular" Style="{StaticResource Mini}" />
                            <Label Text="{Binding DatosPago.Titular}" />
                            <Label Text="{Binding DatosPago.Banco}" Style="{StaticResource Secundario}" />
                        </VerticalStackLayout>

                        <Button Text="Subir comprobante" Command="{Binding SubirComprobanteCommand}"
                                IsEnabled="{Binding NoEstaOcupado}" Margin="0,4,0,0" />
                        <Label Text="Foto o PDF de la transferencia (máx. 5 MB)." Style="{StaticResource Mini}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />

                <!-- Acciones del administrador sobre el pago -->
                <VerticalStackLayout IsVisible="{Binding PuedeAprobarPago}" Spacing="10">
                    <Button Text="Ver comprobante" Command="{Binding VerComprobanteCommand}" Style="{StaticResource BotonSecundario}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Rechazar" Command="{Binding RechazarPagoCommand}" Style="{StaticResource BotonPeligro}" />
                        <Button Grid.Column="1" Text="Aprobar pago" Command="{Binding AprobarPagoCommand}" BackgroundColor="{StaticResource Exito}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Cliente (solo admin) -->
                <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding EsAdmin}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Cliente" Style="{StaticResource Mini}" />
                        <Label Text="{Binding Pedido.Cliente}" FontAttributes="Bold" FontSize="16" />
                        <Label Text="{Binding Pedido.ClienteTelefono, StringFormat='Tel: {0}', TargetNullValue='Sin teléfono'}" Style="{StaticResource Secundario}" />
                        <Label Text="{Binding Pedido.ClienteDireccion, TargetNullValue='Sin dirección'}" Style="{StaticResource Secundario}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Productos -->
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Productos" Style="{StaticResource Mini}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pedido.Items}" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:PedidoItemDto">
                                    <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                                        <Border StrokeThickness="0" BackgroundColor="{StaticResource FondoSuave}" StrokeShape="RoundRectangle 10"
                                                WidthRequest="56" HeightRequest="56" Padding="4">
                                            <Image Source="{Binding ImagenCompleta}" Aspect="AspectFit" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Producto}" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Detalle}" Style="{StaticResource Secundario}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding SubtotalTexto}" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource Borde}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total" Style="{StaticResource Subtitulo}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Pedido.TotalTexto}" FontSize="22" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding TieneObservaciones}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Observaciones" Style="{StaticResource Mini}" />
                        <Label Text="{Binding Pedido.Observaciones}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Historial de estados (HistorialPedidos): fecha, quién y comentario -->
                <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding TieneHistorial}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Historial del pedido" Style="{StaticResource Subtitulo}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Historial}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:HistorialPedidoDto">
                                    <Grid ColumnDefinitions="12,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto">
                                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding Color}"
                                                 VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding EstadoTexto}" FontAttributes="Bold" FontSize="14" />
                                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding Detalle}" Style="{StaticResource Secundario}" FontSize="12" />
                                        <Label Grid.Column="1" Grid.Row="2" Text="{Binding Comentario}" FontSize="13" FontAttributes="Italic"
                                               TextColor="{StaticResource TextoSecundario}" IsVisible="{Binding TieneComentario}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Documentos -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Documentos" Style="{StaticResource Mini}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="Ver PDF" Command="{Binding AbrirPdfCommand}" Style="{StaticResource BotonSecundario}" FontSize="13" Padding="4,0" />
                        <Button Grid.Column="1" Text="Compartir" Command="{Binding CompartirPdfCommand}" Style="{StaticResource BotonSecundario}" FontSize="13" Padding="4,0" />
                        <Button Grid.Column="2" Text="Email" Command="{Binding EnviarPdfPorEmailCommand}" Style="{StaticResource BotonSecundario}" FontSize="13" Padding="4,0" />
                    </Grid>
                    <Button Text="Ver comprobante de pago" Command="{Binding VerComprobanteCommand}" Style="{StaticResource BotonTexto}"
                            IsVisible="{Binding PuedeVerComprobante}" />
                </VerticalStackLayout>

                <!-- Otras acciones -->
                <VerticalStackLayout Spacing="10" Margin="0,4,0,20">
                    <Button Text="Marcar como entregado" Command="{Binding EntregarCommand}" IsVisible="{Binding PuedeEntregar}" />
                    <Button Text="Volver a comprar" Command="{Binding VolverAComprarCommand}" IsVisible="{Binding PuedeVolverAComprar}" />
                    <Button Text="Cancelar pedido" Command="{Binding CancelarCommand}" IsVisible="{Binding PuedeCancelarAdmin}"
                            Style="{StaticResource BotonTexto}" TextColor="{StaticResource Peligro}" />
                    <Button Text="Cancelar mi pedido" Command="{Binding CancelarCommand}" IsVisible="{Binding PuedeCancelarComprador}"
                            Style="{StaticResource BotonTexto}" TextColor="{StaticResource Peligro}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
