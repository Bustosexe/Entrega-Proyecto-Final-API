<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             xmlns:m="clr-namespace:TechHub.App.Models"
             x:Class="TechHub.App.Views.PedidoDetallePage"
             x:DataType="vm:PedidoDetalleViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />

            <!-- Estado -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Pedido.Codigo}" Style="{StaticResource Subtitulo}" />
                        <Border Grid.Column="1" Style="{StaticResource Etiqueta}" BackgroundColor="{Binding Pedido.EstadoColor}">
                            <Label Text="{Binding Pedido.Estado}" Style="{StaticResource TextoEtiqueta}" FontSize="12" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding Pedido.FechaTexto}" Style="{StaticResource Secundario}" />
                    <Label Text="{Binding EstadoAyuda}" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- Cliente (solo admin) -->
            <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding EsAdmin}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Cliente" Style="{StaticResource Rotulo}" Margin="0" />
                    <Label Text="{Binding Pedido.Cliente}" FontAttributes="Bold" />
                    <Label Text="{Binding Pedido.ClienteTelefono, StringFormat='Tel: {0}', TargetNullValue='Sin teléfono'}" Style="{StaticResource Secundario}" />
                    <Label Text="{Binding Pedido.ClienteDireccion, TargetNullValue='Sin dirección'}" Style="{StaticResource Secundario}" />
                </VerticalStackLayout>
            </Border>

            <!-- Productos -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Productos" Style="{StaticResource Rotulo}" Margin="0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pedido.Items}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:PedidoItemDto">
                                <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10">
                                    <Image Source="{Binding ImagenCompleta}" WidthRequest="54" HeightRequest="54" Aspect="AspectFit" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Producto}" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Detalle}" Style="{StaticResource Secundario}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding SubtotalTexto}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="{StaticResource Borde}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Total" Style="{StaticResource Subtitulo}" />
                        <Label Grid.Column="1" Text="{Binding Pedido.TotalTexto}" FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource Primario}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding TieneObservaciones}">
                <VerticalStackLayout>
                    <Label Text="Observaciones" Style="{StaticResource Rotulo}" Margin="0" />
                    <Label Text="{Binding Pedido.Observaciones}" />
                </VerticalStackLayout>
            </Border>

            <!-- Acciones -->
            <Button Text="Confirmar pago" Command="{Binding ConfirmarCommand}" IsVisible="{Binding PuedeConfirmar}" />
            <Button Text="Marcar como entregado" Command="{Binding EntregarCommand}" IsVisible="{Binding PuedeEntregar}"
                    Style="{StaticResource BotonSecundario}" />
            <Button Text="Cancelar pedido" Command="{Binding CancelarCommand}" IsVisible="{Binding PuedeCancelarAdmin}"
                    Style="{StaticResource BotonPeligro}" />
            <Button Text="Cancelar mi pedido" Command="{Binding CancelarCommand}" IsVisible="{Binding PuedeCancelarComprador}"
                    Style="{StaticResource BotonPeligro}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
