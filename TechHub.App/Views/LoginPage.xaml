<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             x:Class="TechHub.App.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="">

    <ScrollView>
        <VerticalStackLayout Padding="28,24" Spacing="10">
            <Image Source="logo.png" HeightRequest="56" WidthRequest="56" HorizontalOptions="Start" />
            <Label Text="Hola de nuevo" FontSize="32" FontAttributes="Bold" Margin="0,18,0,0" />
            <Label Text="Ingresá para comprar y seguir tus pedidos." Style="{StaticResource Secundario}" FontSize="16" Margin="0,0,0,18" />

            <Label Text="Email o usuario" Style="{StaticResource Mini}" />
            <Border Style="{StaticResource CampoBorde}">
                <Entry Text="{Binding Usuario}" Keyboard="Email" Placeholder="tu@email.com" ReturnType="Next" />
            </Border>

            <Label Text="Contraseña" Style="{StaticResource Mini}" Margin="0,8,0,0" />
            <Border Style="{StaticResource CampoBorde}">
                <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••" ReturnType="Go"
                       ReturnCommand="{Binding IngresarCommand}" />
            </Border>

            <Button Text="Ingresar" Command="{Binding IngresarCommand}" IsEnabled="{Binding NoEstaOcupado}" Margin="0,22,0,0" />
            <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,18,0,0">
                <Label Text="¿No tenés cuenta?" Style="{StaticResource Secundario}" VerticalOptions="Center" />
                <Button Text="Creala gratis" Command="{Binding IrARegistroCommand}" Style="{StaticResource BotonTexto}" Padding="4,0" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
