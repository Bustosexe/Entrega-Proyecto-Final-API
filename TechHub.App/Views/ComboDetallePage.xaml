<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             xmlns:m="clr-namespace:TechHub.App.Models"
             x:Class="TechHub.App.Views.ComboDetallePage"
             x:DataType="vm:ComboDetalleViewModel"
             Title="{Binding Titulo}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Carrito" IconImageSource="ic_carrito.png" Command="{Binding IrAlCarritoCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,12" Spacing="10">
                <Border Style="{StaticResource Etiqueta}" BackgroundColor="{StaticResource Primario}">
                    <Label Text="{Binding Combo.DescuentoTexto}" Style="{StaticResource TextoEtiqueta}" />
                </Border>
                <Label Text="{Binding Combo.Nombre}" Style="{StaticResource Titulo}" />
                <Label Text="{Binding Combo.Descripcion, TargetNullValue=''}" Style="{StaticResource Secundario}" />

                <HorizontalStackLayout Spacing="10">
                    <Label Text="{Binding Combo.PrecioTexto}" FontSize="28" FontAttributes="Bold" />
                    <Label Text="{Binding Combo.PrecioListaTexto}" FontSize="16" TextDecorations="Strikethrough"
                           TextColor="{StaticResource TextoSecundario}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="{Binding Combo.AhorroTexto}" FontAttributes="Bold" TextColor="{StaticResource Primario}" />
                <Border Style="{StaticResource Etiqueta}" BackgroundColor="{Binding Combo.StockColor}">
                    <Label Text="{Binding Combo.StockTexto}" Style="{StaticResource TextoEtiqueta}" FontSize="12" />
                </Border>

                <Label Text="Incluye" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Combo.Items}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:ComboItemDto">
                            <Border Style="{StaticResource Tarjeta}" Padding="12">
                                <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="12">
                                    <Image Source="{Binding ImagenCompleta}" HeightRequest="64" WidthRequest="64" Aspect="AspectFit" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Categoria}" Style="{StaticResource Mini}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding PrecioTexto}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Primario}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding PrecioListaTexto}" FontSize="11" TextDecorations="Strikethrough"
                                               TextColor="{StaticResource TextoSecundario}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="White" Stroke="{StaticResource Borde}" StrokeThickness="1"
                StrokeShape="RoundRectangle 24,24,0,0" Padding="20,14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Button Text="−" Style="{StaticResource BotonCircular}" Command="{Binding RestarCommand}" />
                    <Label Text="{Binding Cantidad}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"
                           WidthRequest="30" HorizontalTextAlignment="Center" />
                    <Button Text="+" Style="{StaticResource BotonCircular}" Command="{Binding SumarCommand}" />
                </HorizontalStackLayout>
                <Button Grid.Column="1" Text="Agregar combo al carrito" Command="{Binding AgregarCommand}"
                        IsEnabled="{Binding PuedeComprar}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
