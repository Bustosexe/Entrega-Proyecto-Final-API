<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             x:Class="TechHub.App.Views.IngresoFormPage"
             x:DataType="vm:IngresoFormViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="6">
            <Label Text="Registrá la mercadería que llegó de un proveedor. El stock del producto se suma automáticamente."
                   Style="{StaticResource Secundario}" />

            <Label Text="Producto *" Style="{StaticResource Rotulo}" />
            <Border Style="{StaticResource CampoBorde}">
                <Entry Text="{Binding BuscarProducto}" Placeholder="Filtrar productos..." />
            </Border>
            <Border Style="{StaticResource CampoBorde}">
                <Picker ItemsSource="{Binding Productos}" SelectedItem="{Binding Producto}" Title="Seleccionar producto" />
            </Border>

            <Label Text="Proveedor *" Style="{StaticResource Rotulo}" />
            <Border Style="{StaticResource CampoBorde}">
                <Picker ItemsSource="{Binding Proveedores}" SelectedItem="{Binding Proveedor}" Title="Seleccionar proveedor" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="Cantidad *" Style="{StaticResource Rotulo}" />
                    <Border Style="{StaticResource CampoBorde}">
                        <Entry Text="{Binding Cantidad}" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Costo unitario ($) *" Style="{StaticResource Rotulo}" />
                    <Border Style="{StaticResource CampoBorde}">
                        <Entry Text="{Binding CostoUnitario}" Keyboard="Numeric" Placeholder="700000" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label Text="N° de comprobante" Style="{StaticResource Rotulo}" />
            <Border Style="{StaticResource CampoBorde}">
                <Entry Text="{Binding NumeroComprobante}" Placeholder="A-0001-00001234" MaxLength="50" />
            </Border>

            <Label Text="Observaciones" Style="{StaticResource Rotulo}" />
            <Border Style="{StaticResource CampoBorde}">
                <Entry Text="{Binding Observaciones}" MaxLength="500" />
            </Border>

            <Button Text="Registrar ingreso" Command="{Binding GuardarCommand}" IsEnabled="{Binding NoEstaOcupado}" Margin="0,16,0,0" />
            <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
