<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             xmlns:m="clr-namespace:TechHub.App.Models"
             x:Class="TechHub.App.Views.PanelPage"
             x:DataType="vm:PanelViewModel"
             Title="Panel de control">

    <RefreshView IsRefreshing="{Binding EstaRefrescando}" Command="{Binding CargarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="14" Spacing="12">

                <Label Text="{Binding Saludo}" Style="{StaticResource Titulo}" />

                <!-- Pedidos pendientes (acción principal del admin) -->
                <Border Style="{StaticResource Tarjeta}" BackgroundColor="{StaticResource Oscuro}" Stroke="{StaticResource Oscuro}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Pedidos pendientes" TextColor="#94A3B8" FontSize="13" />
                            <Label Text="{Binding Pendientes}" TextColor="White" FontSize="30" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Ver pedidos" Command="{Binding VerPendientesCommand}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Indicadores -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout>
                            <Label Text="Facturación de hoy" Style="{StaticResource Secundario}" />
                            <Label Text="{Binding FacturacionHoy}" Style="{StaticResource KpiValor}" />
                            <Label Text="{Binding VentasHoy}" Style="{StaticResource Secundario}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout>
                            <Label Text="Facturación del mes" Style="{StaticResource Secundario}" />
                            <Label Text="{Binding FacturacionMes}" Style="{StaticResource KpiValor}" />
                            <Label Text="sin pedidos cancelados" Style="{StaticResource Secundario}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout>
                            <Label Text="Unidades en stock" Style="{StaticResource Secundario}" />
                            <Label Text="{Binding Unidades}" Style="{StaticResource KpiValor}" />
                            <Label Text="{Binding Productos}" Style="{StaticResource Secundario}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout>
                            <Label Text="Valor del inventario" Style="{StaticResource Secundario}" />
                            <Label Text="{Binding ValorInventario}" Style="{StaticResource KpiValor}" />
                            <Label Text="a precio de venta" Style="{StaticResource Secundario}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="{Binding ClientesProveedores}" Style="{StaticResource Secundario}" HorizontalTextAlignment="Center" />

                <!-- Gráfico: facturación de los últimos 7 días -->
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Ventas de los últimos 7 días" Style="{StaticResource Subtitulo}" />
                                <Label Text="{Binding PedidosSemana}" Style="{StaticResource Secundario}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding TotalSemana}" Style="{StaticResource KpiValor}" FontSize="17"
                                   VerticalOptions="Center" />
                        </Grid>
                        <GraphicsView x:Name="GraficoVentasView" Drawable="{Binding GraficoVentas}" HeightRequest="190" />
                    </VerticalStackLayout>
                </Border>

                <!-- Ranking: productos más vendidos -->
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Productos más vendidos" Style="{StaticResource Subtitulo}" />
                        <Label Text="Todavía no hay ventas registradas." Style="{StaticResource Secundario}"
                               IsVisible="{Binding SinVentasTop}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopProductos}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:TopProductoDto">
                                    <Grid ColumnDefinitions="28,40,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto">
                                        <Label Grid.RowSpan="3" Text="{Binding PuestoTexto}" FontAttributes="Bold"
                                               TextColor="{StaticResource Primario}" VerticalOptions="Center" />
                                        <Image Grid.Column="1" Grid.RowSpan="3" Source="{Binding ImagenCompleta}"
                                               WidthRequest="40" HeightRequest="40" Aspect="AspectFit" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Producto}" FontAttributes="Bold" FontSize="13"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="2" Grid.Row="1" Text="{Binding Detalle}" Style="{StaticResource Secundario}" FontSize="12" />
                                        <ProgressBar Grid.Column="2" Grid.Row="2" Progress="{Binding Proporcion}"
                                                     ProgressColor="{StaticResource Primario}" Margin="0,2,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Alerta de stock bajo -->
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Productos para reponer" Style="{StaticResource Subtitulo}" />
                            <Border Grid.Column="1" Style="{StaticResource Etiqueta}" BackgroundColor="{StaticResource Alerta}">
                                <Label Text="{Binding StockBajoCantidad}" Style="{StaticResource TextoEtiqueta}" />
                            </Border>
                        </Grid>
                        <Label Text="Todo el stock está por encima del mínimo." Style="{StaticResource Secundario}"
                               IsVisible="{Binding SinStockBajo}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding StockBajo}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:ProductoDto">
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnProductoTocado" />
                                        </Grid.GestureRecognizers>
                                        <Image Source="{Binding ImagenCompleta}" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Nombre}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding StockMinimo, StringFormat='Mínimo: {0}'}" Style="{StaticResource Secundario}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding StockTexto}" TextColor="{Binding StockColor}"
                                               FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
