<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TechHub.App.ViewModels"
             xmlns:m="clr-namespace:TechHub.App.Models"
             x:Class="TechHub.App.Views.ProductoDetallePage"
             x:DataType="vm:ProductoDetalleViewModel"
             Title="{Binding Titulo}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Carrito" IconImageSource="ic_carrito.png" Command="{Binding IrAlCarritoCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Spacing="0">
                <Border Style="{StaticResource CajaImagen}" Margin="20,8,20,0" Padding="24">
                    <Image Source="{Binding Producto.ImagenCompleta}" HeightRequest="240" Aspect="AspectFit" />
                </Border>

                <VerticalStackLayout Padding="20,18" Spacing="8">
                    <Label Text="{Binding Producto.MarcaCategoria}" Style="{StaticResource Secundario}" />
                    <Label Text="{Binding Producto.Nombre}" Style="{StaticResource Titulo}" />
                    <Label Text="{Binding Producto.PrecioTexto}" FontSize="28" FontAttributes="Bold" />

                    <Border Style="{StaticResource Etiqueta}" BackgroundColor="{Binding Producto.StockColor}">
                        <Label Text="{Binding Producto.StockTexto}" Style="{StaticResource TextoEtiqueta}" FontSize="12" />
                    </Border>

                    <Label Text="Descripción" Style="{StaticResource Subtitulo}" Margin="0,12,0,0" />
                    <Label Text="{Binding Producto.Descripcion, TargetNullValue='Sin descripción.'}" Style="{StaticResource Secundario}" FontSize="14" />
                </VerticalStackLayout>

                <!-- También te puede interesar -->
                <VerticalStackLayout IsVisible="{Binding TieneRelacionados}" Spacing="8" Padding="18,0,18,18">
                    <Label Text="También te puede interesar" Style="{StaticResource Subtitulo}" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Relacionados}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:ProductoDto">
                                    <Border Style="{StaticResource Tarjeta}" Padding="10" WidthRequest="145">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRelacionadoTocado" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="4">
                                            <Image Source="{Binding ImagenCompleta}" HeightRequest="75" Aspect="AspectFit" />
                                            <Label Text="{Binding Nombre}" FontSize="12" FontAttributes="Bold" MaxLines="2"
                                                   LineBreakMode="TailTruncation" HeightRequest="34" />
                                            <Label Text="{Binding PrecioTexto}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primario}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra inferior: cantidad + agregar -->
        <Border Grid.Row="1" BackgroundColor="White" Stroke="{StaticResource Borde}" StrokeThickness="1"
                StrokeShape="RoundRectangle 24,24,0,0" Padding="20,14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Button Text="−" Style="{StaticResource BotonCircular}" Command="{Binding RestarCommand}" />
                    <Label Text="{Binding Cantidad}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"
                           WidthRequest="30" HorizontalTextAlignment="Center" />
                    <Button Text="+" Style="{StaticResource BotonCircular}" Command="{Binding SumarCommand}" />
                </HorizontalStackLayout>
                <Button Grid.Column="1" Text="Agregar al carrito" Command="{Binding AgregarCommand}"
                        IsEnabled="{Binding PuedeComprar}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
